---
/**
 * The Mimi Creates wordmark, recreated in HTML/SVG so it stays crisp
 * at any size. If you prefer the original PNG logo, drop it into
 * /public/images/logo.png and swap this component for an <img>.
 */
interface Props {
  stacked?: boolean;
}
const { stacked = false } = Astro.props;
---

<span class:list={["logo", { stacked }]} translate="no">
  <svg
    class="logo-heart"
    viewBox="0 0 24 22"
    aria-hidden="true"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M12 21C9 17.5 1 12.6 1 6.9 1 3.4 3.7 1 6.7 1 8.9 1 10.9 2.2 12 4 13.1 2.2 15.1 1 17.3 1 20.3 1 23 3.4 23 6.9c0 5.7-8 10.6-11 14.1Z"
      fill="var(--teal, #2ea39b)"
    ></path>
  </svg>
  <span class="logo-mimi">Mimi</span>
  <span class="logo-creates">Creates</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.18em;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
    position: relative;
  }
  .logo-heart {
    width: 0.55em;
    height: auto;
    align-self: flex-start;
    margin-top: -0.1em;
  }
  .logo-mimi {
    color: var(--teal);
  }
  .logo-creates {
    color: var(--teal-dark);
  }
  .logo.stacked {
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .logo.stacked .logo-heart {
    align-self: center;
    margin: 0 0 0.05em;
  }
</style>
