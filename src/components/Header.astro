---
import Logo from "./Logo.astro";
import { ETSY_SHOP_URL } from "../config";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/shop/", label: "Shop" },
  { href: "/blog/", label: "Blog" },
  { href: "/custom-art/", label: "Custom Art" },
  { href: "/about/", label: "About" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") + "/";
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Mimi Creates — home">
      <Logo />
    </a>

    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Toggle menu"
    >
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a
            href={ETSY_SHOP_URL}
            target="_blank"
            rel="noopener"
            class="btn btn-secondary btn-etsy"
          >
            Etsy Shop
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <path
                d="M7 17 17 7M9 7h8v8"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                fill="none"></path>
            </svg>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector(".menu-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 247, 234, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 2px dashed var(--teal-soft);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.8rem;
  }
  .brand {
    font-size: 1.7rem;
    text-decoration: none;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a:not(.btn) {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
    padding: 0.3rem 0.15rem;
    border-bottom: 3px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .site-nav a:not(.btn):hover {
    color: var(--teal);
  }
  .site-nav a[aria-current="page"] {
    color: var(--teal-dark);
    border-bottom-color: var(--yellow);
  }
  .btn-etsy {
    font-size: 0.95rem;
    padding: 0.5rem 1.1rem;
  }
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--teal-dark);
    cursor: pointer;
    padding: 0.4rem;
  }

  @media (max-width: 780px) {
    .menu-toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 2px dashed var(--teal-soft);
      box-shadow: var(--shadow-card);
    }
    .site-nav.open {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.6rem 1.2rem 1.2rem;
    }
    .site-nav li {
      border-bottom: 1px solid var(--cream-deep);
    }
    .site-nav li:last-child {
      border-bottom: none;
    }
    .site-nav a:not(.btn) {
      display: block;
      padding: 0.8rem 0.2rem;
      border-bottom: none;
    }
    .nav-cta {
      padding-top: 0.8rem;
    }
  }
</style>
