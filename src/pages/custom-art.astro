---
import BaseLayout from "../layouts/BaseLayout.astro";
import DuckMascot from "../components/DuckMascot.astro";
import { WEB3FORMS_ACCESS_KEY, SITE_NAME } from "../config";

const title = "Custom Art Request";
const description =
  "Request custom printable art from Mimi Creates: personalized busy book pages, name art, custom coloring pages and more. Tell us your idea and we'll reply by email.";

const keyConfigured = !WEB3FORMS_ACCESS_KEY.startsWith("YOUR_");
const redirectUrl = new URL("/thank-you/", Astro.site).href;

const faqs = [
  {
    q: "What kind of custom art can I request?",
    a: "Almost anything in the Mimi Creates style: personalized busy book pages, name posters, custom coloring pages, birthday printables, flashcards with your own word list, or a matching game starring your child's favorite animal.",
  },
  {
    q: "How much does a custom request cost?",
    a: "It depends on the size of the project. After you send the form, Mimi replies by email with a quote before any work starts — no surprises.",
  },
  {
    q: "How long does a custom order take?",
    a: "Most custom printables are ready within 3–7 days. Larger projects (like a full personalized busy book) can take a little longer — the email reply will include a time estimate.",
  },
  {
    q: "How will I receive my custom art?",
    a: "As a high-resolution printable PDF (and PNG on request) delivered by email or through a private Etsy listing, so your purchase stays protected by Etsy.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Custom Art Request", item: new URL("/custom-art/", Astro.site).href },
    ],
  },
];
---

<BaseLayout {title} {description} {schema}>
  <section class="section text-center form-hero">
    <div class="container">
      <span class="kicker">Made just for you</span>
      <h1>Request Custom Art</h1>
      <p class="lede">
        Dreaming of a busy book page with your little one's name on it? A
        coloring page of their favorite dinosaur? Tell us about it below —
        every request goes straight to Mimi's inbox, and she replies
        personally. 💌
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container form-layout">
      <div class="form-wrap card">
        {
          !keyConfigured && (
            <p class="setup-warning">
              ⚠️ This form isn't activated yet. Site owner: get a free access
              key at <a href="https://web3forms.com">web3forms.com</a> and
              paste it into <code>src/config.ts</code>.
            </p>
          )
        }
        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="custom-art-form"
        >
          <input
            type="hidden"
            name="access_key"
            value={WEB3FORMS_ACCESS_KEY}
          />
          <input
            type="hidden"
            name="subject"
            value={`🎨 New custom art request — ${SITE_NAME}`}
          />
          <input type="hidden" name="from_name" value={`${SITE_NAME} website`} />
          <input type="hidden" name="redirect" value={redirectUrl} />
          <!-- honeypot: real visitors never see or fill this -->
          <input
            type="checkbox"
            name="botcheck"
            class="visually-hidden"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="field">
            <label for="name">Your name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder="e.g. Sarah"
            />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
            />
          </div>

          <div class="field">
            <label for="messenger">WhatsApp number or Telegram username</label>
            <input
              type="text"
              id="messenger"
              name="whatsapp_or_telegram"
              required
              placeholder="e.g. +62 812 3456 7890 or @yourhandle"
            />
            <p class="hint">
              So Mimi can reach you for quick questions about your request.
            </p>
          </div>

          <div class="field">
            <label for="message">Tell us about your idea</label>
            <textarea
              id="message"
              name="message"
              required
              minlength="20"
              placeholder="What would you like Mimi to create? Mention the type of printable (busy book page, coloring page, flashcards…), theme or favorite animals, your child's name/age if relevant, and when you'd like it by."
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">
            Send my request 💌
          </button>
          <p class="privacy-note">
            We only use your details to reply to this request — no newsletters,
            no spam, pinky promise.
          </p>
        </form>
      </div>

      <aside class="form-aside">
        <DuckMascot class="form-duck" />
        <div class="aside-box sticker-border">
          <h2>How it works</h2>
          <ol>
            <li><strong>Send the form</strong> with your idea.</li>
            <li>
              <strong>Get a reply</strong> from Mimi with a quote &amp; timeline.
            </li>
            <li>
              <strong>Approve &amp; receive</strong> your printable PDF, made
              just for you.
            </li>
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-alt" aria-label="Frequently asked questions">
    <div class="container faq-container">
      <h2 class="text-center">Custom Art FAQ</h2>
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .form-hero {
    padding-bottom: 1rem;
  }
  .lede {
    max-width: 60ch;
    margin-inline: auto;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .form-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .form-wrap {
    padding: 2rem;
  }
  .form-wrap:hover {
    transform: none;
  }
  .setup-warning {
    background: var(--coral-soft);
    border: 2px dashed var(--coral);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1rem;
    font-size: 0.92rem;
  }
  .field {
    margin-bottom: 1.2rem;
  }
  .hint {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.3rem 0 0;
  }
  .submit-btn {
    width: 100%;
    font-size: 1.15rem;
    padding-block: 0.85rem;
  }
  .privacy-note {
    text-align: center;
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.9rem 0 0;
  }
  :global(.form-duck) {
    width: 150px;
    margin-inline: auto;
  }
  .aside-box {
    background: var(--paper);
    padding: 1.5rem 1.7rem;
    margin-top: 1rem;
  }
  .aside-box h2 {
    font-size: 1.25rem;
  }
  .aside-box ol {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.6rem;
  }
  .faq-container {
    max-width: 760px;
  }
  .faq-item {
    background: #fff;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    margin-top: 1rem;
    padding: 1.05rem 1.4rem;
  }
  .faq-item summary {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--teal-dark);
    cursor: pointer;
  }
  .faq-item[open] summary {
    margin-bottom: 0.5rem;
  }
  .faq-item p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .form-layout {
      grid-template-columns: 1fr;
    }
    .form-aside {
      order: -1;
    }
    :global(.form-duck) {
      width: 110px;
    }
  }
</style>
