---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DuckMascot from "../components/DuckMascot.astro";
import ProductCard from "../components/ProductCard.astro";
import { featuredProducts, CATEGORIES } from "../data/products";
import { SITE_NAME, ETSY_SHOP_URL } from "../config";

const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const categoryIcons: Record<string, string> = {
  "Busy Books": "📚",
  Worksheets: "✏️",
  "Coloring Pages": "🖍️",
  Flashcards: "🃏",
};
---

<BaseLayout title={SITE_NAME}>
  <!-- ── HERO ─────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>
          <span class="hero-mimi">Mimi</span><span class="hero-creates"
            >Creates</span
          >
        </h1>
        <p class="tagline-banner" aria-label="Learn, play, create">
          <span>♥</span> LEARN · PLAY · CREATE <span>♥</span>
        </p>
        <p class="hero-lede">
          Printable activities, busy books, worksheets &amp; coloring books —
          instant digital downloads, hand-drawn with
          <span class="heart">♥</span> for little learners.
        </p>
        <div class="hero-actions">
          <a href="/shop/" class="btn btn-primary">Shop printables</a>
          <a href="/custom-art/" class="btn btn-secondary">Request custom art</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="star star-1">★</span>
        <span class="star star-2">★</span>
        <span class="star star-3">★</span>
        <DuckMascot class="hero-duck" />
      </div>
    </div>
    <svg
      class="hero-wave"
      viewBox="0 0 1440 70"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0 40 C 240 70 480 5 720 30 C 960 55 1200 20 1440 45 L1440 70 L0 70 Z"
        fill="var(--paper)"></path>
    </svg>
  </section>

  <!-- ── CATEGORIES ───────────────────────────── -->
  <section class="section categories-section" aria-label="Product categories">
    <div class="container">
      <div class="category-grid">
        {
          CATEGORIES.map((cat) => (
            <a href="/shop/" class="category-card card">
              <span class="category-icon" aria-hidden="true">
                {categoryIcons[cat]}
              </span>
              <span class="category-name">{cat}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── FEATURED PRODUCTS ────────────────────── -->
  <section class="section" aria-labelledby="featured-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Little learner favorites</span>
          <h2 id="featured-heading">Featured Printables</h2>
        </div>
        <a href="/shop/" class="btn btn-outline">See all products</a>
      </div>
      <div class="product-grid">
        {
          featuredProducts.slice(0, 4).map((product, i) => (
            <ProductCard {product} eager={i < 2} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── WHY MIMI CREATES ─────────────────────── -->
  <section class="section section-alt" aria-labelledby="why-heading">
    <div class="container">
      <h2 id="why-heading" class="text-center">Made with ♥, ready in minutes</h2>
      <div class="value-grid">
        <div class="value-item">
          <span class="value-icon" aria-hidden="true">⚡</span>
          <h3>Instant download</h3>
          <p>
            Buy on Etsy, download right away, and print at home — no shipping,
            no waiting, anywhere in the world.
          </p>
        </div>
        <div class="value-item">
          <span class="value-icon" aria-hidden="true">🎨</span>
          <h3>Hand-drawn by one artist</h3>
          <p>
            Every page is illustrated by Mimi herself — soft colors, friendly
            faces, and zero clip-art shortcuts.
          </p>
        </div>
        <div class="value-item">
          <span class="value-icon" aria-hidden="true">🔁</span>
          <h3>Print it again &amp; again</h3>
          <p>
            One download, endless rainy days. Reprint pages whenever you need a
            fresh copy — it's yours forever.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── LATEST FROM THE BLOG ─────────────────── -->
  <section class="section" aria-labelledby="blog-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Fresh from Mimi's desk</span>
          <h2 id="blog-heading">Latest from the Blog</h2>
        </div>
        <a href="/blog/" class="btn btn-outline">All posts</a>
      </div>
      <div class="home-post-grid">
        {
          latestPosts.map((post) => (
            <a href={`/blog/${post.id}/`} class="card home-post-card">
              <time datetime={post.data.pubDate.toISOString()}>
                {dateFmt.format(post.data.pubDate)}
              </time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="read-more">Read the post →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── CUSTOM ART CTA ───────────────────────── -->
  <section class="section" aria-labelledby="cta-heading">
    <div class="container">
      <div class="cta-banner">
        <div>
          <h2 id="cta-heading">Have something special in mind?</h2>
          <p>
            Personalized busy book pages, name art, a coloring page of your
            child's favorite animal — Mimi takes custom requests, big and
            small.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/custom-art/" class="btn btn-secondary">Request custom art</a>
          <a
            href={ETSY_SHOP_URL}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
          >
            Visit Etsy shop ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* hero */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--cream) 0%, var(--yellow-soft) 130%);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 2rem;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(4rem, 8vw, 6rem);
  }
  .hero h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    margin-bottom: 0.8rem;
    line-height: 1;
  }
  .hero-mimi {
    color: var(--teal);
  }
  .hero-creates {
    color: var(--teal-dark);
  }
  .tagline-banner {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.22em;
    font-size: clamp(0.8rem, 2vw, 1rem);
    color: #fff;
    background: var(--teal);
    padding: 0.45rem 1.4rem;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(46, 163, 155, 0.35);
  }
  .tagline-banner span {
    color: var(--yellow);
  }
  .hero-lede {
    max-width: 46ch;
    font-size: 1.15rem;
    color: var(--muted);
    margin-top: 1.1rem;
  }
  .heart {
    color: var(--coral);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }
  .hero-art {
    position: relative;
    display: flex;
    justify-content: center;
  }
  :global(.hero-duck) {
    width: clamp(200px, 26vw, 300px);
    filter: drop-shadow(0 12px 24px rgba(138, 90, 40, 0.2));
  }
  .star {
    position: absolute;
    color: var(--yellow);
    text-shadow: 0 2px 6px rgba(247, 200, 68, 0.6);
    animation: twinkle 2.8s ease-in-out infinite;
  }
  .star-1 {
    font-size: 2rem;
    top: 4%;
    left: 8%;
  }
  .star-2 {
    font-size: 1.3rem;
    top: 22%;
    right: 4%;
    animation-delay: 0.9s;
  }
  .star-3 {
    font-size: 1.6rem;
    bottom: 10%;
    left: 2%;
    animation-delay: 1.7s;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
    }
  }
  .hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 70px;
  }

  /* categories */
  .categories-section {
    padding-top: 1rem;
  }
  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }
  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem 1rem;
    text-decoration: none;
    border: 2px dashed transparent;
  }
  .category-card:hover {
    border-color: var(--teal);
  }
  .category-icon {
    font-size: 2.2rem;
  }
  .category-name {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--teal-dark);
  }

  /* shared section head */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.8rem;
  }
  .section-head h2 {
    margin-bottom: 0;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.6rem;
  }

  /* values */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2.2rem;
    text-align: center;
  }
  .value-icon {
    font-size: 2.4rem;
    display: block;
    margin-bottom: 0.6rem;
  }
  .value-item p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  /* blog cards */
  .home-post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }
  .home-post-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.6rem;
    text-decoration: none;
    color: inherit;
  }
  .home-post-card time {
    font-size: 0.83rem;
    font-weight: 700;
    color: var(--teal);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .home-post-card h3 {
    margin: 0.4rem 0 0.5rem;
    font-size: 1.15rem;
  }
  .home-post-card p {
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }
  .read-more {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--teal);
  }
  .home-post-card:hover .read-more {
    color: var(--teal-dark);
  }

  /* CTA banner */
  .cta-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    background: var(--teal);
    border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 4vw, 2.8rem);
    box-shadow: 0 12px 32px rgba(46, 163, 155, 0.35);
  }
  .cta-banner h2,
  .cta-banner p {
    color: #fff;
  }
  .cta-banner p {
    margin: 0;
    max-width: 52ch;
    color: #e2f4f2;
  }
  .cta-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .btn-ghost {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.28);
    color: #fff;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-lede {
      margin-inline: auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-art {
      order: -1;
    }
    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .value-grid,
    .home-post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
