---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href;

/* BlogPosting structured data — the backbone of blog SEO/AI SEO. */
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": postUrl,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    url: postUrl,
    mainEntityOfPage: postUrl,
    author: { "@type": "Person", name: post.data.author },
    publisher: { "@id": new URL("/#organization", Astro.site).href },
    keywords: post.data.tags.join(", "),
    ...(post.data.heroImage && {
      image: new URL(post.data.heroImage, Astro.site).href,
    }),
    isPartOf: {
      "@type": "Blog",
      name: `${SITE_NAME} Blog`,
      url: new URL("/blog/", Astro.site).href,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", Astro.site).href },
      { "@type": "ListItem", position: 3, name: post.data.title, item: postUrl },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.heroImage}
  {schema}
>
  <Fragment slot="head">
    <meta
      property="article:published_time"
      content={post.data.pubDate.toISOString()}
    />
    {
      post.data.updatedDate && (
        <meta
          property="article:modified_time"
          content={post.data.updatedDate.toISOString()}
        />
      )
    }
    <meta property="article:author" content={post.data.author} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <article class="section post">
    <div class="container post-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span>
        <a href="/blog/">Blog</a>
      </nav>

      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          By <span class="author">{post.data.author}</span> ·
          <time datetime={post.data.pubDate.toISOString()}>
            {dateFmt.format(post.data.pubDate)}
          </time>
          {
            post.data.updatedDate && (
              <>
                {" "}· Updated{" "}
                <time datetime={post.data.updatedDate.toISOString()}>
                  {dateFmt.format(post.data.updatedDate)}
                </time>
              </>
            )
          }
        </p>
        {
          post.data.tags.length > 0 && (
            <ul class="tag-list">
              {post.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
        {
          post.data.heroImage && (
            <img
              class="hero-image"
              src={post.data.heroImage}
              alt=""
              width="1200"
              height="630"
            />
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="post-footer sticker-border">
        <p>
          Enjoyed this? Browse our <a href="/shop/">printable shop</a>, say hi
          with a <a href="/custom-art/">custom art request</a>, or subscribe via
          <a href="/rss.xml">RSS</a>. 💛
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-container {
    max-width: 760px;
  }
  .breadcrumbs {
    font-size: 0.9rem;
    margin-bottom: 1.4rem;
    color: var(--muted);
  }
  .breadcrumbs a {
    color: var(--teal);
    text-decoration: none;
    font-weight: 700;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .post-header h1 {
    margin-bottom: 0.4rem;
  }
  .post-meta {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .author {
    font-weight: 800;
    color: var(--teal-dark);
  }
  .tag-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0.6rem 0 0;
  }
  .tag-list li {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--teal-dark);
    background: var(--yellow-soft);
    border-radius: 999px;
    padding: 0.12rem 0.65rem;
  }
  .hero-image {
    border-radius: var(--radius-md);
    margin-top: 1.4rem;
    height: auto;
  }
  .prose {
    margin-top: 1.8rem;
    font-size: 1.06rem;
  }
  .prose :global(h2) {
    margin-top: 2rem;
    font-size: 1.5rem;
  }
  .prose :global(h3) {
    margin-top: 1.6rem;
  }
  .prose :global(img) {
    border-radius: var(--radius-md);
  }
  .prose :global(blockquote) {
    margin: 1.4rem 0;
    padding: 0.9rem 1.3rem;
    background: var(--yellow-soft);
    border-left: 5px solid var(--yellow);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(hr) {
    border: none;
    border-top: 2px dashed var(--teal-soft);
    margin: 2rem 0;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
  .post-footer {
    margin-top: 2.5rem;
    padding: 1.2rem 1.5rem;
    background: var(--paper);
    text-align: center;
  }
  .post-footer p {
    margin: 0;
  }
</style>
