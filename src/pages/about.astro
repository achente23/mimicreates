---
import BaseLayout from "../layouts/BaseLayout.astro";
import DuckMascot from "../components/DuckMascot.astro";
import { ETSY_SHOP_URL, AUTHOR_NAME, SITE_NAME } from "../config";

const title = "About Mimi";
const description =
  "Meet Mimi, the artist behind Mimi Creates — hand-drawn printable busy books, worksheets, flashcards and coloring pages for toddlers and preschoolers.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: title,
    url: new URL("/about/", Astro.site).href,
    mainEntity: {
      "@type": "Person",
      name: AUTHOR_NAME,
      jobTitle: "Illustrator & Printable Designer",
      worksFor: { "@id": new URL("/#organization", Astro.site).href },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
      { "@type": "ListItem", position: 2, name: "About", item: new URL("/about/", Astro.site).href },
    ],
  },
];
---

<BaseLayout {title} {description} {schema}>
  <section class="section">
    <div class="container about-layout">
      <div class="about-art">
        <div class="mascot-frame sticker-border">
          <DuckMascot class="about-duck" />
        </div>
      </div>
      <div class="about-copy">
        <span class="kicker">The artist behind the duck</span>
        <h1>Hi, I'm Mimi 👋</h1>
        <p>
          I'm the illustrator, designer, printer-tester, and chief
          duck-enthusiast behind <strong>{SITE_NAME}</strong>. What began as
          doodles of cute animals grew into a little shop of printable
          learning materials for toddlers and preschoolers.
        </p>
        <p>
          Everything you see here is drawn by hand — the duckling in the
          bonnet, every heart and star, every activity page. I design each
          printable around one question: <em>would a parent and a little one
          genuinely enjoy doing this together?</em> If the answer isn't a
          clear yes, it doesn't make it into the shop.
        </p>
        <p>
          My printables are <strong>instant digital downloads</strong> sold
          through Etsy, so they're affordable, arrive in minutes, and can be
          printed again whenever you need a fresh copy. And when something
          extra-special is needed — a busy book page with your child's name,
          a coloring page of a beloved pet — I take
          <a href="/custom-art/">custom requests</a> too.
        </p>
        <p>
          Thank you for supporting a tiny independent art shop. It means the
          world. 💛
        </p>
        <div class="about-actions">
          <a href="/shop/" class="btn btn-primary">Browse the shop</a>
          <a
            href={ETSY_SHOP_URL}
            target="_blank"
            rel="noopener"
            class="btn btn-outline"
          >
            Find us on Etsy ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 3rem;
    align-items: center;
  }
  .mascot-frame {
    background: var(--paper);
    padding: 2.5rem;
    display: flex;
    justify-content: center;
  }
  :global(.about-duck) {
    width: 100%;
    max-width: 260px;
  }
  .about-copy p {
    color: var(--ink);
  }
  .about-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
  }

  @media (max-width: 820px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .mascot-frame {
      max-width: 320px;
      margin-inline: auto;
    }
  }
</style>
